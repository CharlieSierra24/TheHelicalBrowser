{
  "name": "SOHONorth Helical Browser",
  "short_name": "Helical",
  "description": "Spin through your folders on a helix.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#071655",
  "theme_color": "#1f45c8",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}